MYSQL_ROOT_PASSWORD=root123
# CT_DB_PASSWORD must match MYSQL_ROOT_PASSWORD.
MYSQL_DATABASE=campus_trade
MYSQL_PORT=3306
REDIS_PORT=6379
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_HA_PORT=10912
ROCKETMQ_PROXY_PORT=8081
# Keep the host JVM and MySQL container in Asia/Shanghai for order deadlines.

CT_PROFILE=prod
CT_SERVER_PORT=8080
CT_DB_HOST=127.0.0.1
CT_DB_PORT=3306
CT_DB_NAME=campus_trade
CT_DB_USERNAME=root
CT_DB_PASSWORD=root123
CT_REDIS_HOST=127.0.0.1
CT_REDIS_PORT=6379
CT_REDIS_DATABASE=0
CT_REDIS_PASSWORD=
CT_UPLOAD_DIR=C:/campus-trade/uploads
CT_JWT_SECRET=change-this-to-a-long-random-secret
CT_JWT_TTL=7d
CT_ORDER_TIMEOUT_SCAN_ENABLED=true
CT_ORDER_TIMEOUT_SCAN_DELAY_MS=60000
CT_ORDER_TIMEOUT_MESSAGE_ENABLED=true
CT_ROCKETMQ_ENDPOINTS=127.0.0.1:8081
CT_ROCKETMQ_ORDER_TIMEOUT_TOPIC=campus_trade_order_timeout
CT_ROCKETMQ_ORDER_TIMEOUT_TAG=CONFIRM_TIMEOUT
CT_ROCKETMQ_ORDER_TIMEOUT_CONSUMER_GROUP=campus_trade_order_timeout_consumer
NGINX_PORT=80
