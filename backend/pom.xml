<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        继续使用项目设计中约定的 Spring Boot 3。
        3.5.x 同时支持 Java 17 和当前机器上的较新 JDK，便于本地开发与部署环境保持兼容。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.campus</groupId>
    <artifactId>campus-trade</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>campus-trade</name>
    <description>校园二手交易平台后端服务</description>

    <properties>
        <!-- 无论构建命令使用哪个 JDK，生成的字节码都必须兼容 Java 17。 -->
        <java.version>17</java.version>
        <mybatis-spring-boot.version>3.0.4</mybatis-spring-boot.version>
        <redisson.version>4.6.1</redisson.version>
        <jjwt.version>0.13.0</jjwt.version>
        <rocketmq-client.version>5.2.0</rocketmq-client.version>
        <spring-ai.version>1.1.8</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- REST API 与嵌入式 Tomcat。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- DTO 参数校验，例如 @NotBlank、@Size 和 @Valid。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 健康检查端点，后续部署和容器编排会使用。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 按项目约定使用原生 MyBatis，让关键 SQL 和并发条件更新保持可见。 -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>

        <!--
            Spring Data Redis 会自动配置 StringRedisTemplate。
            当前登录态和商品缓存只需要 Redis 字符串的 GET / SET / DEL，因此使用它能让代码与 Redis 命令一一对应。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
            商品详情使用 Caffeine 作为进程内一级缓存：先命中本机内存，再查询 Redis。
            只缓存短 TTL 的公开详情，数据库写入后的失效逻辑会同时清理本地和 Redis，
            因此不引入 Spring Cache 的全局抽象，保持读写路径可见。
        -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            当前业务代码不依赖 Redisson；保留此依赖作为以后确实需要分布式锁、限流器或高级分布式对象时的选择。
            在需求出现前不创建 RedissonClient，避免为简单的字符串读写引入额外抽象。
        -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>${redisson.version}</version>
        </dependency>

        <!--
            RocketMQ 5.x gRPC 客户端：订单创建后发送精确到期时间的延迟消息。
            MQ 只负责及时触发超时关单，数据库订单状态仍是事实源，原定时扫描继续承担补偿。
        -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-client-java</artifactId>
            <version>${rocketmq-client.version}</version>
        </dependency>

        <!-- 认证模块使用 BCrypt；不引入完整 Security 自动配置，避免现阶段自动拦截全部接口。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- JWT 分为编译 API、运行实现和 Jackson JSON 适配三个官方模块。 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- 让 IDE 能提示 application.yml 中的自定义 campus.* 配置项。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打包为可直接 java -jar 启动的 Spring Boot 可执行 JAR。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
