<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.trade.category.mapper.CategoryMapper">

    <!--
        公开接口只返回启用分类。
        sort 相同时再按主键排序，保证多次查询顺序稳定，前端列表不会随机跳动。
    -->
    <select id="selectEnabledCategories"
            resultType="com.campus.trade.category.entity.Category">
        SELECT id,
               name,
               sort,
               enabled
        FROM category
        WHERE enabled = 1
        ORDER BY sort ASC, id ASC
    </select>
</mapper>
